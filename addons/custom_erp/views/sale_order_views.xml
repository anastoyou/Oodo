<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_custom_erp" model="ir.ui.view">
        <field name="name">sale.order.form.custom_erp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_support_tickets"
                    type="object"
                    class="oe_stat_button"
                    icon="chat_bubble"
                    invisible="x_ticket_count == 0 and not id">
                    <field name="x_ticket_count" widget="statinfo" string="Tickets"/>
                </button>
            </xpath>
            <xpath expr="//header/button[@id='action_confirm']" position="before">
                <button
                    name="action_confirm_cod"
                    string="Confirm COD"
                    type="object"
                    class="btn-secondary"
                    invisible="x_payment_mode != 'cod' or x_cod_verification_status == 'confirmed' or state == 'cancel'"/>
                <button
                    name="action_flag_cod_rto_risk"
                    string="Flag RTO Risk"
                    type="object"
                    class="btn-outline-danger"
                    invisible="x_payment_mode != 'cod' or x_cod_verification_status == 'cancelled_rto_risk' or state == 'cancel'"/>
                <button
                    name="action_mark_rto"
                    string="Mark RTO"
                    type="object"
                    class="btn-outline-warning"
                    invisible="x_is_rto or state != 'sale'"/>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="x_sales_channel"/>
                <field name="x_payment_mode"/>
                <field name="x_cod_verification_status" invisible="x_payment_mode != 'cod'"/>
                <field name="x_cod_verified_by_id" invisible="not x_cod_verified_by_id"/>
                <field name="x_cod_verified_date" invisible="not x_cod_verified_date"/>
                <field name="x_cod_notes" invisible="x_payment_mode != 'cod'"/>
                <field name="x_is_rto"/>
                <field name="x_rto_reason" invisible="not x_is_rto"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_custom_erp" model="ir.ui.view">
        <field name="name">sale.order.list.custom_erp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="x_sales_channel" optional="show"/>
                <field name="x_payment_mode" optional="show"/>
                <field name="x_cod_verification_status" widget="badge"
                    decoration-warning="x_cod_verification_status == 'pending'"
                    decoration-success="x_cod_verification_status == 'confirmed'"
                    decoration-danger="x_cod_verification_status == 'cancelled_rto_risk'"
                    optional="show"/>
                <field name="x_is_rto" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_custom_erp" model="ir.ui.view">
        <field name="name">sale.order.search.custom_erp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="x_sales_channel"/>
                <filter string="Pending COD Verification" name="filter_cod_pending" domain="[('x_cod_verification_status', '=', 'pending')]"/>
                <filter string="COD Confirmed" name="filter_cod_confirmed" domain="[('x_cod_verification_status', '=', 'confirmed')]"/>
                <filter string="RTO Orders" name="filter_rto_orders" domain="[('x_is_rto', '=', True)]"/>
                <filter string="Social (WhatsApp / Instagram)" name="filter_social_orders" domain="[('x_sales_channel', 'in', ('whatsapp', 'instagram'))]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Sales Channel" name="group_sales_channel" context="{'group_by': 'x_sales_channel'}"/>
                <filter string="Payment Mode" name="group_payment_mode" context="{'group_by': 'x_payment_mode'}"/>
                <filter string="COD Status" name="group_cod_status" context="{'group_by': 'x_cod_verification_status'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_orders_cod_queue" model="ir.actions.act_window">
        <field name="name">COD Verification Queue</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="domain">[('x_payment_mode', '=', 'cod'), ('state', '!=', 'cancel')]</field>
        <field name="context">{'search_default_filter_cod_pending': 1, 'default_x_payment_mode': 'cod', 'default_x_cod_verification_status': 'pending'}</field>
    </record>

    <record id="action_orders_channel_margin_ops" model="ir.actions.act_window">
        <field name="name">Channel &amp; Margin Ops</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="domain">[('state', '=', 'sale')]</field>
        <field name="context">{'search_default_group_sales_channel': 1}</field>
    </record>

    <menuitem
        id="menu_sale_cod_verification_queue"
        name="COD Verification Queue"
        parent="sale.sale_order_menu"
        action="action_orders_cod_queue"
        sequence="35"/>

    <menuitem
        id="menu_sale_channel_margin_ops"
        name="Channel &amp; Margin Ops"
        parent="sale.menu_sale_report"
        action="action_orders_channel_margin_ops"
        sequence="25"/>
</odoo>

