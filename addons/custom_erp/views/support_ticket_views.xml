<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_support_ticket_tree" model="ir.ui.view">
        <field name="name">custom.support.ticket.list</field>
        <field name="model">custom.support.ticket</field>
        <field name="arch" type="xml">
            <list string="Support Tickets" sample="1" multi_edit="1">
                <field name="name" decoration-bf="1"/>
                <field name="subject"/>
                <field name="partner_id" optional="show"/>
                <field name="contact_email" optional="hide"/>
                <field name="contact_phone" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="category" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="stage" widget="badge"
                    decoration-info="stage == 'new'"
                    decoration-warning="stage in ('in_progress', 'waiting_customer')"
                    decoration-success="stage == 'resolved'"
                    decoration-muted="stage == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_custom_support_ticket_kanban" model="ir.ui.view">
        <field name="name">custom.support.ticket.kanban</field>
        <field name="model">custom.support.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" highlight_color="color" sample="1" class="o_kanban_small_column">
                <field name="stage"/>
                <field name="priority"/>
                <field name="color"/>
                <field name="sale_order_id"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <div role="separator" class="dropdown-divider"/>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <field name="name" class="fw-bold text-primary small"/>
                            <field name="category" widget="badge" decoration-info="1"/>
                        </div>
                        <field name="subject" class="fw-semibold mt-1"/>
                        <div class="text-muted small mt-1" invisible="not partner_id and not contact_name">
                            <field name="partner_id" invisible="not partner_id"/>
                            <field name="contact_name" invisible="partner_id or not contact_name"/>
                        </div>
                        <div class="small text-muted" invisible="not sale_order_id">
                            Order: <field name="sale_order_id"/>
                        </div>
                        <footer class="pt-2">
                            <field name="priority" widget="priority"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_custom_support_ticket_search" model="ir.ui.view">
        <field name="name">custom.support.ticket.search</field>
        <field name="model">custom.support.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Support Tickets">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="contact_email"/>
                <field name="contact_phone"/>
                <field name="sale_order_id"/>
                <filter string="My Tickets" name="my_tickets" domain="[('user_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter string="Open Queue" name="open_tickets" domain="[('stage', 'in', ('new', 'in_progress', 'waiting_customer'))]"/>
                <filter string="Size Exchanges" name="size_exchanges" domain="[('category', '=', 'size_exchange')]"/>
                <filter string="High / Urgent" name="high_priority" domain="[('priority', 'in', ('2', '3'))]"/>
                <group>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage'}"/>
                    <filter string="Issue Type" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Assigned Agent" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_custom_support_ticket_form" model="ir.ui.view">
        <field name="name">custom.support.ticket.form</field>
        <field name="model">custom.support.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button name="action_assign_to_me" string="Assign to Me" type="object" class="btn-secondary" invisible="user_id"/>
                    <button name="action_start_progress" string="Start Progress" type="object" class="oe_highlight" invisible="stage != 'new'"/>
                    <button name="action_wait_customer" string="Wait on Customer" type="object" class="btn-secondary" invisible="stage not in ('new', 'in_progress')"/>
                    <button name="action_resolve" string="Resolve" type="object" class="oe_highlight" invisible="stage in ('resolved', 'closed')"/>
                    <button name="action_close" string="Close" type="object" invisible="stage == 'closed'"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="stage not in ('resolved', 'closed')"/>
                    <field name="stage" widget="statusbar" statusbar_visible="new,in_progress,waiting_customer,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"><field name="name" readonly="1"/></span>
                        <h1>
                            <field name="subject" placeholder="Brief summary of customer request..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Order">
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="contact_email" widget="email"/>
                            <field name="contact_phone" widget="phone"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group string="Triage &amp; Ownership">
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="closed_date" invisible="not closed_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customer Issue" name="issue_details">
                            <field name="description" placeholder="Detailed customer description, size requested, or delivery notes..."/>
                        </page>
                        <page string="Resolution Notes" name="resolution_details">
                            <field name="resolution_notes" placeholder="Exchange AWB, refund status, or resolution notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_custom_support_ticket_all" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">custom.support.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open_tickets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create or track customer support &amp; size exchange tickets
            </p>
        </field>
    </record>

    <record id="action_custom_support_ticket_exchanges" model="ir.actions.act_window">
        <field name="name">Size Exchange Requests</field>
        <field name="res_model">custom.support.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_size_exchanges': 1, 'search_default_open_tickets': 1}</field>
    </record>

    <menuitem
        id="menu_custom_helpdesk_root"
        name="Helpdesk"
        web_icon="custom_erp,static/description/icon.png"
        sequence="55"
        groups="base.group_user"/>

    <menuitem
        id="menu_custom_helpdesk_tickets"
        name="Support Tickets"
        parent="menu_custom_helpdesk_root"
        action="action_custom_support_ticket_all"
        sequence="10"/>

    <menuitem
        id="menu_custom_helpdesk_exchanges"
        name="Size Exchanges"
        parent="menu_custom_helpdesk_root"
        action="action_custom_support_ticket_exchanges"
        sequence="20"/>

    <menuitem
        id="menu_sale_support_tickets"
        name="Support Tickets"
        parent="sale.sale_order_menu"
        action="action_custom_support_ticket_all"
        sequence="40"/>
</odoo>

