<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_custom_erp" model="ir.ui.view">
        <field name="name">account.move.form.custom_erp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="x_sales_channel" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not x_sales_channel"/>
                <field name="x_payment_mode" widget="badge"
                    decoration-success="x_payment_mode == 'prepaid'"
                    decoration-warning="x_payment_mode == 'cod'"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not x_payment_mode"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_custom_erp" model="ir.ui.view">
        <field name="name">account.out.invoice.list.custom_erp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="before">
                <field name="x_sales_channel" optional="show"/>
                <field name="x_payment_mode" widget="badge"
                    decoration-success="x_payment_mode == 'prepaid'"
                    decoration-warning="x_payment_mode == 'cod'"
                    optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_custom_erp" model="ir.ui.view">
        <field name="name">account.payment.form.custom_erp</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-light border py-2 mb-3 small" role="status">
                    <strong>Reconciliation Tip:</strong> Record the Razorpay Payment ID, UPI UTR, or Courier COD settlement reference in the Memo field for monthly bank reconciliation.
                </div>
            </xpath>
        </field>
    </record>
</odoo>

