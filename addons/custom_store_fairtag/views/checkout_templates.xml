<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="checkout_fairtag" inherit_id="website_sale.checkout_layout" name="FAIRTAG Checkout Layout">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="t-attf-class" add="#{'o_fairtag_checkout' if (website and website.x_store_code == 'fairtag') else ''}" separator=" "/>
        </xpath>
    </template>
</odoo>
