<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="checkout_zoira" inherit_id="website_sale.checkout_layout" name="ZOIRA LAWNS Checkout Layout">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="t-attf-class" add="#{'o_zoira_checkout' if (website and website.x_store_code == 'zoira') else ''}" separator=" "/>
        </xpath>
    </template>
</odoo>
