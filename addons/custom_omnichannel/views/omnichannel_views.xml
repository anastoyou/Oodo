<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template: Subscription & Rental Flags -->
    <record id="product_template_form_custom_omnichannel" model="ir.ui.view">
        <field name="name">product.template.form.custom.omnichannel</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']/group" position="after">
                <group string="Enterprise Subscriptions &amp; Online Rentals">
                    <group>
                        <field name="x_is_subscription"/>
                        <field name="x_subscription_plan_id" invisible="not x_is_subscription"/>
                    </group>
                    <group>
                        <field name="x_is_rental"/>
                        <field name="x_rental_deposit" invisible="not x_is_rental"/>
                        <field name="x_rental_default_days" invisible="not x_is_rental"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Sale Order: Provisioned Subscriptions & Rentals Smart Buttons -->
    <record id="view_order_form_custom_omnichannel" model="ir.ui.view">
        <field name="name">sale.order.form.custom.omnichannel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_subscriptions" type="object" class="oe_stat_button" icon="fa-repeat" invisible="x_subscription_count == 0">
                    <field name="x_subscription_count" widget="statinfo" string="Subscriptions"/>
                </button>
                <button name="action_view_rentals" type="object" class="oe_stat_button" icon="fa-calendar" invisible="x_rental_count == 0">
                    <field name="x_rental_count" widget="statinfo" string="Rentals"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- e-Sign Request: Generate & Download Stamped PDF -->
    <record id="view_custom_sign_request_form_pdf" model="ir.ui.view">
        <field name="name">custom.sign.request.form.pdf</field>
        <field name="model">custom.sign.request</field>
        <field name="inherit_id" ref="custom_enterprise.view_custom_sign_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_signed_pdf" string="Generate Signed PDF" type="object" class="btn-secondary" invisible="state != 'signed'"/>
            </xpath>
            <xpath expr="//field[@name='document_filename']" position="after">
                <field name="signed_pdf" filename="signed_pdf_filename"/>
                <field name="signed_pdf_filename" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>

