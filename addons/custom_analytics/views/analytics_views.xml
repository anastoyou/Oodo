<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Live Analytics Board Form View -->
    <record id="view_custom_analytics_board_form" model="ir.ui.view">
        <field name="name">custom.analytics.board.form</field>
        <field name="model">custom.analytics.board</field>
        <field name="arch" type="xml">
            <form string="Executive &amp; Cross-ERP Analytics">
                <header>
                    <button name="action_refresh" string="Apply Filters &amp; Refresh" type="object" class="btn-primary"/>
                    <button name="action_preset_7d" string="Last 7 Days" type="object" class="btn-secondary"/>
                    <button name="action_preset_30d" string="Last 30 Days" type="object" class="btn-secondary"/>
                    <button name="action_preset_90d" string="Last 90 Days" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Cross-ERP Business Analytics Console</h1>
                    </div>
                    <group string="Interactive Filters (Customer, Channel, Payment, Period &amp; Module)">
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active_module"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="partner_id" placeholder="All Customers..."/>
                            <field name="sales_channel" placeholder="All Channels..."/>
                            <field name="payment_mode" placeholder="Prepaid &amp; COD..."/>
                        </group>
                    </group>
                    <group>
                        <group string="Sales, Margin &amp; Period Comparison">
                            <field name="total_sales"/>
                            <field name="prev_total_sales"/>
                            <field name="sales_growth_pct"/>
                            <field name="total_margin"/>
                            <field name="margin_growth_pct"/>
                            <field name="margin_pct"/>
                            <field name="order_count"/>
                            <field name="orders_growth_pct"/>
                            <field name="prepaid_order_count"/>
                            <field name="cod_order_count"/>
                            <field name="rto_order_count"/>
                            <field name="rto_rate_pct"/>
                        </group>
                        <group string="Purchase &amp; Inventory Comparison">
                            <field name="purchase_spend"/>
                            <field name="prev_purchase_spend"/>
                            <field name="purchase_growth_pct"/>
                            <field name="purchase_count"/>
                            <field name="inventory_value"/>
                            <field name="low_stock_count"/>
                        </group>
                    </group>
                    <group>
                        <group string="Finance &amp; CRM Pipeline">
                            <field name="invoiced_revenue"/>
                            <field name="vendor_bills_total"/>
                            <field name="customer_receivable"/>
                            <field name="vendor_payable"/>
                            <field name="crm_pipeline_value"/>
                            <field name="crm_open_count"/>
                        </group>
                        <group string="Subscriptions, HR &amp; Support">
                            <field name="active_mrr"/>
                            <field name="active_rental_total"/>
                            <field name="payroll_total"/>
                            <field name="timesheet_hours"/>
                            <field name="open_rma_count"/>
                            <field name="open_ticket_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales Channels">
                            <field name="channel_line_ids" readonly="1">
                                <list>
                                    <field name="channel_name"/>
                                    <field name="order_count" sum="Orders"/>
                                    <field name="revenue" sum="Revenue"/>
                                    <field name="share_pct"/>
                                    <field name="cod_count" sum="COD"/>
                                    <field name="rto_count" sum="RTO"/>
                                </list>
                            </field>
                        </page>
                        <page string="Top Customers">
                            <field name="customer_line_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="order_count" sum="Orders"/>
                                    <field name="revenue" sum="Revenue"/>
                                    <field name="share_pct"/>
                                    <field name="cod_count" sum="COD"/>
                                </list>
                            </field>
                        </page>
                        <page string="Top Selling Products">
                            <field name="product_line_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="units_sold" sum="Units"/>
                                    <field name="revenue" sum="Revenue"/>
                                </list>
                            </field>
                        </page>
                        <page string="Top Vendors">
                            <field name="vendor_line_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="po_count" sum="POs"/>
                                    <field name="total_spend" sum="Spend"/>
                                </list>
                            </field>
                        </page>
                        <page string="Inventory &amp; Low Stock">
                            <field name="stock_line_ids" readonly="1">
                                <list decoration-danger="is_low_stock">
                                    <field name="product_id"/>
                                    <field name="qty_on_hand" sum="On Hand"/>
                                    <field name="qty_reserved" sum="Reserved"/>
                                    <field name="qty_available" sum="Available"/>
                                    <field name="stock_value" sum="Value"/>
                                    <field name="is_low_stock"/>
                                </list>
                            </field>
                        </page>
                        <page string="Daily Trend vs Prev. Period">
                            <field name="trend_line_ids" readonly="1">
                                <list>
                                    <field name="period_date"/>
                                    <field name="order_count" sum="Orders"/>
                                    <field name="sales_amount" sum="Sales"/>
                                    <field name="prev_sales_amount" sum="Prev. Sales"/>
                                    <field name="purchase_amount" sum="Purchases"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_custom_analytics_board" model="ir.actions.act_window">
        <field name="name">Live Analytics Console</field>
        <field name="res_model">custom.analytics.board</field>
        <field name="view_mode">form</field>
    </record>

    <record id="action_open_analytics_web" model="ir.actions.act_url">
        <field name="name">Open Visual Analytics (/analytics)</field>
        <field name="url">/analytics</field>
        <field name="target">new</field>
    </record>

    <!-- 1. Sales Channel, COD & RTO Pivot + Graph -->
    <record id="view_sale_order_analytics_graph" model="ir.ui.view">
        <field name="name">sale.order.analytics.graph</field>
        <field name="model">sale.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <graph string="Sales by Channel &amp; Payment Mode" type="bar" sample="1">
                <field name="x_sales_channel"/>
                <field name="x_payment_mode"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sale_order_analytics_pivot" model="ir.ui.view">
        <field name="name">sale.order.analytics.pivot</field>
        <field name="model">sale.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Channel, COD &amp; RTO Pivot Analysis" sample="1">
                <field name="x_sales_channel" type="row"/>
                <field name="x_payment_mode" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sale_order_analytics_search" model="ir.ui.view">
        <field name="name">sale.order.analytics.search</field>
        <field name="model">sale.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search string="Filter Sales Analytics">
                <field name="partner_id" string="Customer"/>
                <field name="x_sales_channel" string="Channel"/>
                <field name="x_payment_mode" string="Payment Mode"/>
                <field name="name" string="Order #"/>
                <filter string="Prepaid" name="filter_prepaid" domain="[('x_payment_mode', '=', 'prepaid')]"/>
                <filter string="COD Only" name="filter_cod" domain="[('x_payment_mode', '=', 'cod')]"/>
                <filter string="RTO Flagged" name="filter_rto" domain="[('x_is_rto', '=', True)]"/>
                <separator/>
                <filter string="Order Date" name="filter_date" date="date_order"/>
                <group>
                    <filter string="Customer" name="grp_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Sales Channel" name="grp_channel" context="{'group_by': 'x_sales_channel'}"/>
                    <filter string="Payment Mode" name="grp_payment" context="{'group_by': 'x_payment_mode'}"/>
                    <filter string="Order Month" name="grp_month" context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_analytics_sales_channels" model="ir.actions.act_window">
        <field name="name">Channel, COD &amp; RTO Analytics</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('state', '=', 'sale')]</field>
        <field name="search_view_id" ref="view_sale_order_analytics_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'graph', 'view_id': ref('view_sale_order_analytics_graph')}),
            (0, 0, {'sequence': 2, 'view_mode': 'pivot', 'view_id': ref('view_sale_order_analytics_pivot')})]"/>
    </record>

