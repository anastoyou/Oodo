<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approvals -->
    <record id="view_custom_approval_category_list" model="ir.ui.view">
        <field name="name">custom.approval.category.list</field>
        <field name="model">custom.approval.category</field>
        <field name="arch" type="xml">
            <list string="Approval Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="approval_minimum"/>
                <field name="amount_threshold"/>
                <field name="approver_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_custom_approval_request_list" model="ir.ui.view">
        <field name="name">custom.approval.request.list</field>
        <field name="model">custom.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests">
                <field name="name"/>
                <field name="subject"/>
                <field name="category_id"/>
                <field name="request_owner_id"/>
                <field name="amount"/>
                <field name="date_needed"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'new'"
                    decoration-warning="state == 'pending'"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="view_custom_approval_request_form" model="ir.ui.view">
        <field name="name">custom.approval.request.form</field>
        <field name="model">custom.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'new'"/>
                    <button name="action_approve_my_step" string="Approve" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_refuse_my_step" string="Refuse" type="object" class="btn-outline-danger" invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('approved', 'refused', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"><field name="name"/></span>
                        <h1><field name="subject" placeholder="e.g. Approve Capex / High Discount / Partner Draw"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="request_owner_id"/>
                            <field name="amount"/>
                            <field name="date_needed"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="purchase_order_id"/>
                            <field name="account_move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Justification">
                            <field name="reason"/>
                        </page>
                        <page string="Approvers">
                            <field name="approver_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="status" widget="badge"/>
                                    <field name="decision_date"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Documents (DMS) -->
    <record id="view_custom_document_folder_list" model="ir.ui.view">
        <field name="name">custom.document.folder.list</field>
        <field name="model">custom.document.folder</field>
        <field name="arch" type="xml">
            <list string="Document Folders" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_custom_document_list" model="ir.ui.view">
        <field name="name">custom.document.list</field>
        <field name="model">custom.document</field>
        <field name="arch" type="xml">
            <list string="Documents">
                <field name="name"/>
                <field name="folder_id"/>
                <field name="document_type"/>
                <field name="partner_id"/>
                <field name="version"/>
                <field name="expiry_date"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <record id="view_custom_document_form" model="ir.ui.view">
        <field name="name">custom.document.form</field>
        <field name="model">custom.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_create_vendor_bill" string="Create Vendor Bill" type="object" class="btn-secondary"/>
                    <button name="action_create_support_ticket" string="Create Support Ticket" type="object" class="btn-secondary"/>
                    <button name="action_request_approval" string="Request Approval" type="object" class="oe_highlight"/>
                    <button name="action_send_for_signature" string="Send for e-Sign" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Document Title..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="folder_id"/>
                            <field name="document_type"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="partner_id"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="expiry_date"/>
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="vendor_bill_id" invisible="not vendor_bill_id"/>
                            <field name="ticket_id" invisible="not ticket_id"/>
                            <field name="approval_id" invisible="not approval_id"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Document summary, GSTIN, or renewal notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_custom_approval_category" model="ir.actions.act_window">
        <field name="name">Approval Types</field>
        <field name="res_model">custom.approval.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_custom_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">custom.approval.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_custom_document_folder" model="ir.actions.act_window">
        <field name="name">Document Folders</field>
        <field name="res_model">custom.document.folder</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_custom_document" model="ir.actions.act_window">
        <field name="name">Documents (DMS)</field>
        <field name="res_model">custom.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

