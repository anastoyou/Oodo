<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_custom_payslip" model="ir.actions.report">
        <field name="name">Employee Payslip</field>
        <field name="model">custom.hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_enterprise.report_payslip_document</field>
        <field name="binding_model_id" ref="model_custom_hr_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_payslip_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Payslip: <span t-field="o.name"/></h2>
                        <table class="table table-sm table-bordered mt-3">
                            <tr>
                                <th>Employee</th><td><span t-field="o.employee_id.name"/></td>
                                <th>Period</th><td><span t-field="o.date_from"/> to <span t-field="o.date_to"/></td>
                            </tr>
                            <tr>
                                <th>Paid Days</th><td><span t-field="o.working_days"/> (LOP: <span t-field="o.lop_days"/>)</td>
                                <th>Monthly Gross</th><td><span t-field="o.monthly_gross"/></td>
                            </tr>
                        </table>
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Component</th>
                                    <th>Type</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.code"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-field="line.rule_type"/></td>
                                    <td class="text-end"><span t-field="line.amount"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="mt-3 text-end">
                            <strong>Total Earnings: </strong><span t-field="o.total_earnings"/><br/>
                            <strong>Total Deductions: </strong><span t-field="o.total_deductions"/><br/>
                            <h4>Net Payable: <span t-field="o.net_wage"/></h4>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
