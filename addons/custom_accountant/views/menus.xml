<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Upgrade the top-level Invoicing app to full Enterprise Accounting -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="name">Accounting</field>
        <field name="web_icon">custom_accountant,static/description/icon.png</field>
        <field name="sequence" eval="45"/>
        <field name="group_ids" eval="[(6, 0, [ref('account.group_account_readonly'), ref('account.group_account_invoice'), ref('account.group_account_user'), ref('account.group_account_manager')])]"/>
    </record>

    <!-- ================= CUSTOMERS ================= -->
    <menuitem id="menu_custom_batch_deposit"
              name="Batch Deposits"
              parent="account.menu_finance_receivables"
              action="action_custom_batch_payment_inbound"
              sequence="18"
              groups="account.group_account_invoice"/>

    <menuitem id="menu_custom_followup_reports"
              name="Follow-up Reports"
              parent="account.menu_finance_receivables"
              action="action_custom_followup_customers"
              sequence="25"
              groups="account.group_account_invoice"/>

    <!-- ================= VENDORS ================= -->
    <menuitem id="menu_custom_vendor_bill_ocr"
              name="Digitize Bill (OCR)"
              parent="account.menu_finance_payables"
              action="action_custom_bill_ocr_wizard"
              sequence="5"
              groups="account.group_account_invoice"/>

    <menuitem id="menu_custom_vendor_batch_payment"
              name="Batch Payments"
              parent="account.menu_finance_payables"
              action="action_custom_batch_payment_outbound"
              sequence="25"
              groups="account.group_account_invoice"/>

    <!-- ================= ACCOUNTING ================= -->
    <menuitem id="menu_action_account_moves_all_in_accounting"
              name="Journal Items"
              parent="account.account_transactions_menu"
              action="account.action_account_moves_all"
              groups="account.group_account_readonly"
              sequence="5"/>

    <menuitem id="menu_account_bank_cash"
              name="Bank &amp; Cash"
              parent="account.menu_finance_entries"
              sequence="8"
              groups="account.group_account_basic"/>

    <menuitem id="menu_account_bank_reconcile_console"
              name="Bank Reconciliation"
              parent="menu_account_bank_cash"
              action="action_custom_bank_reconcile_wizard"
              sequence="10"/>

    <menuitem id="menu_account_bank_statements"
              name="Bank Statements"
              parent="menu_account_bank_cash"
              action="account.action_bank_statement_tree"
              sequence="20"/>

    <menuitem id="menu_account_bank_import_csv"
              name="Import Bank / UPI CSV"
              parent="menu_account_bank_cash"
              action="custom_enterprise.action_custom_bank_import_wizard"
              sequence="30"/>

    <menuitem id="menu_account_reconcile_models"
              name="Reconciliation Models"
              parent="menu_account_bank_cash"
              action="account.action_account_reconcile_model"
              sequence="40"/>

    <menuitem id="menu_account_assets_deferred"
              name="Assets &amp; Deferreds"
              parent="account.menu_finance_entries"
              sequence="12"
              groups="account.group_account_readonly"/>

    <menuitem id="menu_account_fixed_assets"
              name="Fixed Assets"
              parent="menu_account_assets_deferred"
              action="custom_enterprise.action_custom_asset"
              sequence="10"/>

    <menuitem id="menu_account_deferred_schedules"
              name="Deferred Revenues &amp; Expenses"
              parent="menu_account_assets_deferred"
              action="custom_enterprise.action_custom_deferred_schedule"
              sequence="20"/>

    <menuitem id="menu_account_auto_transfers"
              name="Automatic Transfers"
              parent="menu_account_assets_deferred"
              action="action_custom_auto_transfer"
              sequence="30"/>

    <!-- Closing Submenus -->
    <menuitem id="menu_account_fiscal_years"
              name="Fiscal Years"
              parent="account.account_closing_menu"
              action="action_custom_fiscal_year"
              sequence="10"/>

    <menuitem id="menu_account_tax_period_locks"
              name="Lock Dates"
              parent="account.account_closing_menu"
              action="action_custom_tax_lock_wizard"
              sequence="20"/>

    <menuitem id="menu_account_automatic_entries"
              name="Automatic Entries / Accruals"
              parent="account.account_closing_menu"
              action="account.account_automatic_entry_wizard_action"
              sequence="30"/>

    <menuitem id="menu_account_resequence"
              name="Re-sequence Entries"
              parent="account.account_closing_menu"
              action="account.action_account_resequence"
              sequence="40"/>

    <!-- ================= REVIEW ================= -->
    <menuitem id="menu_account_lock_exceptions"
              name="Lock Date Exceptions"
              parent="account.account_audit_control_menu"
              action="action_custom_lock_exceptions"
              sequence="15"/>

    <menuitem id="menu_account_disallowed_analysis"
              name="Disallowed Expenses"
              parent="account.account_audit_control_menu"
              action="action_custom_disallowed_expense_report"
              sequence="20"/>

    <menuitem id="menu_account_audit_trail"
              name="Audit Trail"
              parent="account.account_audit_control_menu"
              action="action_custom_audit_trail"
              sequence="30"/>

    <!-- ================= REPORTING ================= -->
    <!-- Statement Reports -->
    <menuitem id="menu_report_pnl"
              name="Profit and Loss"
              parent="account.account_reports_legal_statements_menu"
              action="action_report_pnl"
              sequence="10"/>

    <menuitem id="menu_report_balance_sheet"
              name="Balance Sheet"
              parent="account.account_reports_legal_statements_menu"
              action="action_report_balance_sheet"
              sequence="20"/>

    <menuitem id="menu_report_executive_summary"
              name="Executive Summary"
              parent="account.account_reports_legal_statements_menu"
              action="action_report_executive_summary"
              sequence="30"/>

    <menuitem id="menu_report_cashflow"
              name="Cash Flow Statement"
              parent="account.account_reports_legal_statements_menu"
              action="action_report_cashflow"
              sequence="40"/>

    <menuitem id="menu_report_consolidation"
              name="Multi-Company Consolidation"
              parent="account.account_reports_legal_statements_menu"
              action="action_custom_consolidation_wizard"
              sequence="50"/>

    <!-- Audit Reports -->
    <menuitem id="account_reports_audit_menu"
              name="Audit Reports"
              parent="account.menu_finance_reports"
              sequence="2"
              groups="account.group_account_readonly"/>

    <menuitem id="menu_report_general_ledger"
              name="General Ledger"
              parent="account_reports_audit_menu"
              action="action_report_general_ledger"
              sequence="10"/>

    <menuitem id="menu_report_trial_balance"
              name="Trial Balance"
              parent="account_reports_audit_menu"
              action="action_report_trial_balance"
              sequence="20"/>

    <menuitem id="menu_report_journal_audit"
              name="Journal Audit"
              parent="account_reports_audit_menu"
              action="action_report_journal_audit"
              sequence="30"/>

    <!-- Partner Reports -->
    <menuitem id="menu_report_partner_ledger"
              name="Partner Ledger"
              parent="account.account_reports_partners_reports_menu"
              action="action_report_partner_ledger"
              sequence="10"/>

    <menuitem id="menu_report_aged_receivable"
              name="Aged Receivable"
              parent="account.account_reports_partners_reports_menu"
              action="action_report_aged_receivable"
              sequence="20"/>

    <menuitem id="menu_report_aged_payable"
              name="Aged Payable"
              parent="account.account_reports_partners_reports_menu"
              action="action_report_aged_payable"
              sequence="30"/>

    <!-- Taxes & Fiscal -->
    <menuitem id="menu_report_tax_return"
              name="Tax Return / GST Summary"
              parent="account.account_reports_taxes_and_fiscal_menu"
              action="action_report_tax_return"
              sequence="10"/>

    <!-- Management -->
    <menuitem id="menu_report_budgets"
              name="Budgets &amp; Variance"
              parent="account.account_reports_management_menu"
              action="custom_enterprise.action_custom_account_budget"
              sequence="15"/>

    <menuitem id="menu_report_disallowed_expenses"
              name="Disallowed Expenses"
              parent="account.account_reports_management_menu"
              action="action_custom_disallowed_expense_report"
              sequence="25"/>

    <menuitem id="menu_report_equity_cap_table"
              name="Equity Cap Table"
              parent="account.account_reports_management_menu"
              action="action_custom_equity_holder"
              sequence="35"/>

    <!-- ================= CONFIGURATION ================= -->
    <menuitem id="menu_config_fiscal_years"
              name="Fiscal Years"
              parent="account.account_account_menu"
              action="action_custom_fiscal_year"
              sequence="15"/>

    <menuitem id="menu_config_asset_categories"
              name="Asset Categories"
              parent="account.account_account_menu"
              action="custom_enterprise.action_custom_asset_category"
              sequence="20"/>

    <menuitem id="menu_config_followup_levels"
              name="Follow-up Levels"
              parent="account.account_account_menu"
              action="action_custom_followup_level"
              sequence="25"/>

    <menuitem id="menu_config_reconcile_models"
              name="Reconciliation Models"
              parent="account.account_account_menu"
              action="account.action_account_reconcile_model"
              sequence="30"/>

    <menuitem id="menu_config_auto_reconcile_rules"
              name="Bank Auto-Reconcile Rules"
              parent="account.account_account_menu"
              action="custom_enterprise.action_custom_bank_reconcile_rule"
              sequence="35"/>

    <menuitem id="menu_config_auto_transfers"
              name="Automatic Transfer Rules"
              parent="account.account_account_menu"
              action="action_custom_auto_transfer"
              sequence="40"/>

    <menuitem id="menu_config_disallowed_categories"
              name="Disallowed Expense Categories"
              parent="account.account_account_menu"
              action="action_custom_disallowed_expense_category"
              sequence="45"/>

    <!-- Keep Enterprise Finance submenu populated with Pro tools too -->
    <menuitem id="menu_custom_bank_reconcile_console"
              name="Interactive Bank Reconcile"
              parent="custom_enterprise.menu_custom_accounting_enterprise"
              action="action_custom_bank_reconcile_wizard"
              sequence="42"/>
    <menuitem id="menu_custom_bill_ocr"
              name="Vendor Bill OCR Extractor"
              parent="custom_enterprise.menu_custom_accounting_enterprise"
              action="action_custom_bill_ocr_wizard"
              sequence="48"/>
    <menuitem id="menu_custom_consolidation"
              name="Consolidation &amp; Cash Flow"
              parent="custom_enterprise.menu_custom_accounting_enterprise"
              action="action_custom_consolidation_wizard"
              sequence="50"/>
    <menuitem id="menu_custom_tax_lock"
              name="Tax &amp; Period Locks"
              parent="custom_enterprise.menu_custom_accounting_enterprise"
              action="action_custom_tax_lock_wizard"
              sequence="55"/>
    <menuitem id="menu_custom_equity_cap_table"
              name="Equity Cap Table"
              parent="custom_enterprise.menu_custom_accounting_enterprise"
              action="action_custom_equity_holder"
              sequence="60"/>
</odoo>
