<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asset Disposal & Modification Wizards -->
    <record id="view_custom_asset_disposal_wizard_form" model="ir.ui.view">
        <field name="name">custom.asset.disposal.wizard.form</field>
        <field name="model">custom.asset.disposal.wizard</field>
        <field name="arch" type="xml">
            <form string="Sell or Dispose Fixed Asset">
                <group>
                    <group>
                        <field name="asset_id"/>
                        <field name="disposal_type"/>
                        <field name="disposal_date"/>
                    </group>
                    <group>
                        <field name="sale_amount" invisible="disposal_type != 'sell'"/>
                        <field name="proceeds_account_id" invisible="disposal_type != 'sell'" required="disposal_type == 'sell'"/>
                        <field name="loss_gain_account_id"/>
                        <field name="note"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_disposal" string="Confirm Disposal &amp; Post Entry" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_custom_asset_modify_wizard_form" model="ir.ui.view">
        <field name="name">custom.asset.modify.wizard.form</field>
        <field name="model">custom.asset.modify.wizard</field>
        <field name="arch" type="xml">
            <form string="Modify / Revalue Asset">
                <group>
                    <field name="asset_id"/>
                    <field name="useful_life_months"/>
                    <field name="salvage_value"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_apply_modification" string="Apply &amp; Recompute Schedule" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Extend custom.asset form with Sell / Dispose & Modify buttons -->
    <record id="view_custom_asset_form_ext" model="ir.ui.view">
        <field name="name">custom.asset.form.accountant.ext</field>
        <field name="model">custom.asset</field>
        <field name="inherit_id" ref="custom_enterprise.view_custom_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_close']" position="before">
                <button name="action_open_modify_wizard" string="Modify Depreciation" type="object" invisible="state != 'running'"/>
                <button name="action_open_disposal_wizard" string="Sell or Dispose" type="object" class="btn-secondary" invisible="state != 'running'"/>
            </xpath>
            <xpath expr="//field[@name='book_value']" position="after">
                <field name="disposal_date" invisible="not disposal_move_id"/>
                <field name="disposal_proceeds" invisible="not disposal_move_id"/>
                <field name="disposal_move_id" invisible="not disposal_move_id"/>
            </xpath>
        </field>
    </record>

    <!-- Auto-Deferred columns on Invoice / Bill lines -->
    <record id="view_move_form_deferred_ext" model="ir.ui.view">
        <field name="name">account.move.form.deferred.ext</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='price_subtotal']" position="before">
                <field name="x_deferred_periods" optional="hide"/>
                <field name="x_deferred_account_id" optional="hide"/>
                <field name="x_generated_deferred_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Enhance Accounting Journal Dashboard Bank/Cash cards with Reconcile & Import buttons -->
    <record id="account_journal_dashboard_kanban_accountant" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.accountant</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='bank_cash_buttons']" position="inside">
                <button name="action_open_reconcile_console" type="object" class="btn btn-secondary" groups="account.group_account_basic">
                    Reconcile
                </button>
                <button name="action_open_bank_import" type="object" class="btn btn-secondary" groups="account.group_account_basic">
                    Import CSV
                </button>
            </xpath>
        </field>
    </record>

    <!-- Enhance Interactive Bank Reconcile Console with 1-Click Auto-Reconcile All -->
    <record id="view_custom_bank_reconcile_wizard_form_ext" model="ir.ui.view">
        <field name="name">custom.bank.reconcile.wizard.form.ext</field>
        <field name="model">custom.bank.reconcile.wizard</field>
        <field name="inherit_id" ref="custom_accountant.view_custom_bank_reconcile_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reload_lines']" position="after">
                <button name="action_auto_reconcile_all" string="Auto-Reconcile All Matches" type="object" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
