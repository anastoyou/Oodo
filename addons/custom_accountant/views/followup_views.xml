<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Follow-up Levels -->
    <record id="view_custom_followup_level_list" model="ir.ui.view">
        <field name="name">custom.followup.level.list</field>
        <field name="model">custom.followup.level</field>
        <field name="arch" type="xml">
            <list string="Follow-up Levels">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="delay"/>
                <field name="send_email"/>
                <field name="auto_execute"/>
                <field name="block_sales"/>
            </list>
        </field>
    </record>

    <record id="view_custom_followup_level_form" model="ir.ui.view">
        <field name="name">custom.followup.level.form</field>
        <field name="model">custom.followup.level</field>
        <field name="arch" type="xml">
            <form string="Follow-up Level">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="delay"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="send_email"/>
                            <field name="auto_execute"/>
                            <field name="block_sales"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Reminder Message Template">
                        <field name="note" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_custom_followup_level" model="ir.actions.act_window">
        <field name="name">Follow-up Levels</field>
        <field name="res_model">custom.followup.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Customer Follow-up Reports List & Form -->
    <record id="view_partner_followup_list" model="ir.ui.view">
        <field name="name">res.partner.followup.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Customer Follow-up Reports" create="false" delete="false">
                <field name="display_name" string="Customer"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="followup_level_id"/>
                <field name="followup_next_action_date"/>
                <field name="total_overdue" sum="Total Overdue"/>
                <field name="total_due" sum="Total Due"/>
                <field name="followup_status" widget="badge"
                       decoration-danger="followup_status == 'in_need_of_action'"
                       decoration-warning="followup_status == 'with_overdue_invoices'"
                       decoration-success="followup_status == 'no_action_needed'"/>
            </list>
        </field>
    </record>

    <record id="view_partner_followup_form" model="ir.ui.view">
        <field name="name">res.partner.followup.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Customer Follow-up Statement" create="false" delete="false">
                <header>
                    <button name="action_send_followup_email" string="Send Reminder Email" type="object" class="btn-primary"/>
                    <button name="action_print_followup_statement" string="Print Statement PDF" type="object" class="btn-secondary"/>
                    <button name="action_followup_done" string="Mark Done / Snooze 15d" type="object" class="btn-secondary"/>
                    <field name="followup_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="followup_reminder_type"/>
                            <field name="followup_next_action_date"/>
                        </group>
                        <group>
                            <field name="followup_level_id"/>
                            <field name="total_due"/>
                            <field name="total_overdue"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Open &amp; Overdue Receivable Invoices">
                            <field name="followup_line_ids" readonly="1">
                                <list>
                                    <field name="move_id"/>
                                    <field name="date"/>
                                    <field name="date_maturity"/>
                                    <field name="name"/>
                                    <field name="debit" string="Original"/>
                                    <field name="amount_residual" string="Amount Due" sum="Total Due"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_partner_followup_search" model="ir.ui.view">
        <field name="name">res.partner.followup.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Follow-up Search">
                <field name="name"/>
                <filter string="In Need of Action" name="need_action" domain="[('followup_status', '=', 'in_need_of_action')]"/>
                <filter string="With Overdue Invoices" name="with_overdue" domain="[('followup_status', 'in', ('in_need_of_action', 'with_overdue_invoices'))]"/>
            </search>
        </field>
    </record>

    <record id="action_custom_followup_customers" model="ir.actions.act_window">
        <field name="name">Customer Follow-up Reports</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_partner_followup_search"/>
        <field name="context">{'search_default_with_overdue': 1}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_followup_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_partner_followup_form')}),
        ]"/>
    </record>

    <!-- Add Follow-up fields to Partner Accounting tab -->
    <record id="view_partner_form_followup_ext" model="ir.ui.view">
        <field name="name">res.partner.form.followup.ext</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']/group" position="inside">
                <group string="Customer Follow-up" name="followup_group" groups="account.group_account_invoice,account.group_account_readonly">
                    <field name="followup_reminder_type"/>
                    <field name="followup_next_action_date"/>
                    <field name="followup_status" widget="badge"/>
                    <field name="total_overdue"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
