<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_batch_payment_list" model="ir.ui.view">
        <field name="name">custom.batch.payment.list</field>
        <field name="model">custom.batch.payment</field>
        <field name="arch" type="xml">
            <list string="Batch Payments">
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="batch_type"/>
                <field name="payment_count"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'sent'"
                       decoration-success="state == 'reconciled'"/>
            </list>
        </field>
    </record>

    <record id="view_custom_batch_payment_form" model="ir.ui.view">
        <field name="name">custom.batch.payment.form</field>
        <field name="model">custom.batch.payment</field>
        <field name="arch" type="xml">
            <form string="Batch Payment">
                <header>
                    <button name="action_validate_batch" string="Validate Batch" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_print_batch_slip" string="Print Batch Slip" type="object" class="btn-secondary"/>
                    <button name="action_mark_reconciled" string="Mark Reconciled" type="object" class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,reconciled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="batch_type" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="payment_count"/>
                            <field name="amount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batch Payments">
                            <field name="payment_ids" readonly="state != 'draft'"
                                   context="{'default_journal_id': journal_id, 'default_payment_type': batch_type}">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="memo"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_custom_batch_payment_inbound" model="ir.actions.act_window">
        <field name="name">Batch Deposits</field>
        <field name="res_model">custom.batch.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('batch_type', '=', 'inbound')]</field>
        <field name="context">{'default_batch_type': 'inbound'}</field>
    </record>

    <record id="action_custom_batch_payment_outbound" model="ir.actions.act_window">
        <field name="name">Vendor Batch Payments</field>
        <field name="res_model">custom.batch.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('batch_type', '=', 'outbound')]</field>
        <field name="context">{'default_batch_type': 'outbound'}</field>
    </record>

    <!-- Link Batch Payment & Payment Voucher Print on account.payment -->
    <record id="view_account_payment_form_batch_ext" model="ir.ui.view">
        <field name="name">account.payment.form.batch.ext</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_payment_voucher" string="Print Payment Voucher" type="object" class="btn-secondary" invisible="state == 'draft'"/>
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="batch_payment_id" readonly="1" invisible="not batch_payment_id"/>
            </xpath>
        </field>
    </record>
</odoo>
