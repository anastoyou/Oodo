<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Match Odoo Enterprise Accountant group hierarchy:
             Accounting Administrator implies Show Full Accounting Features (group_account_user),
             which in turn implies group_account_basic and group_account_readonly. -->
        <record id="account.group_account_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
    </data>
</odoo>
