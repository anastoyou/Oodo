<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_followup_statement" model="ir.actions.report">
        <field name="name">Customer Follow-up Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_accountant.report_followup_statement_doc</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_followup_statement_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Customer Account Statement &amp; Overdue Follow-up</h2>
                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>Customer:</strong> <span t-field="o.name"/><br/>
                                <span t-if="o.email" t-field="o.email"/><br/>
                                <span t-if="o.phone" t-field="o.phone"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Statement Date:</strong> <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/><br/>
                                <strong>Total Due:</strong> <span t-field="o.total_due"/><br/>
                                <strong>Total Overdue:</strong> <span t-field="o.total_overdue"/>
                            </div>
                        </div>

                        <t t-if="o.followup_level_id and o.followup_level_id.note">
                            <div class="alert alert-light border mb-3">
                                <p t-out="o.followup_level_id.note" style="white-space: pre-line;"/>
                            </div>
                        </t>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Invoice / Entry</th>
                                    <th>Date</th>
                                    <th>Due Date</th>
                                    <th>Communication</th>
                                    <th class="text-end">Original Amount</th>
                                    <th class="text-end">Amount Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.followup_line_ids" t-as="line">
                                    <td><span t-field="line.move_id.name"/></td>
                                    <td><span t-field="line.date"/></td>
                                    <td><span t-field="line.date_maturity"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.debit"/></td>
                                    <td class="text-end fw-bold"><span t-field="line.amount_residual"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
