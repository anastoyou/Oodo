<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Exported & customized Footer (website.footer_custom) outside core odoo/. -->
    <template id="footer_custom" inherit_id="website.footer_custom" name="Custom Store Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo o_custom_store_footer text-break" t-ignore="true" t-if="not no_footer">
                <section class="s_text_block pt40 pb24" data-snippet="s_text_block" data-name="Container">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-lg-3 col-sm-6 pt16 pb16">
                                <h5>Shop &amp; Catalog</h5>
                                <ul class="list-unstyled d-flex flex-column gap-1">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/shop">Shop All Apparel</a></li>
                                    <li><a href="/blog">Lookbook &amp; Care Blog</a></li>
                                    <li><a href="/size-guide">Apparel Size Guide</a></li>
                                    <li><a href="/my">My Account &amp; Orders</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-3 col-sm-6 pt16 pb16">
                                <h5>Policies &amp; Care</h5>
                                <ul class="list-unstyled d-flex flex-column gap-1">
                                    <li><a href="/shipping-policy">Shipping &amp; Dispatch</a></li>
                                    <li><a href="/return-policy">Returns &amp; Size Exchanges</a></li>
                                    <li><a href="/support">Support &amp; Exchange Desk</a></li>
                                    <li><a href="/my/tickets">Track Support Ticket</a></li>
                                    <t t-set="configurator_footer_links" t-value='[{"text": "Privacy Policy", "href": "/privacy"}]'/>
                                    <li t-foreach="configurator_footer_links" t-as="link">
                                        <a t-att-href="link['href']" t-out="link['text']"/>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-lg-3 col-sm-6 pt16 pb16">
                                <h5>About the Brand</h5>
                                <p class="small mb-2">
                                    Curated everyday and festive Indian apparel crafted for comfort, true sizing, and lasting wear with Pan-India doorstep delivery.
                                </p>
                                <p class="small mb-0 opacity-75">
                                    GST-compliant billing &#183; Prepaid UPI/Card priority dispatch &#183; Verified COD support.
                                </p>
                            </div>
                            <div class="col-lg-3 col-sm-6 pt16 pb16">
                                <h5>Customer Care</h5>
                                <ul class="list-unstyled d-flex flex-column gap-2 small">
                                    <li>
                                        <i class="fa fa-life-ring me-2" aria-hidden="true"/>
                                        <a href="/support">Raise Size Exchange / Ticket</a>
                                    </li>
                                    <li>
                                        <i class="fa fa-envelope me-2" aria-hidden="true"/>
                                        <a href="mailto:hello@yourbrand.in">hello@yourbrand.in</a>
                                    </li>
                                    <li>
                                        <i class="fa fa-phone me-2" aria-hidden="true"/>
                                        <a href="tel:+910000000000"><span class="o_force_ltr">+91 00000 00000</span></a>
                                    </li>
                                    <li>
                                        <i class="fa fa-comments me-2" aria-hidden="true"/>
                                        <a href="/contactus">General Contact Form</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
