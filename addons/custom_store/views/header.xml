<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="header_custom" inherit_id="website.template_header_default" name="Custom Store Header">
        <xpath expr="//t[@t-call='website.navbar']" position="before">
            <div class="o_custom_store_announcement w-100 py-1 px-3 text-center d-print-none">
                <span>Free Pan-India shipping on prepaid orders above Rs. 999 &#183; 7-day easy size exchanges</span>
                <span class="d-none d-md-inline ms-2">
                    &#183; <a href="/size-guide">Size Guide</a>
                    &#183; <a href="/support">Help &amp; Exchanges</a>
                </span>
            </div>
        </xpath>

        <xpath expr="//div[@id='o_main_nav']" position="attributes">
            <attribute name="t-attf-class" add="o_custom_store_header" separator=" "/>
        </xpath>
    </template>
</odoo>
