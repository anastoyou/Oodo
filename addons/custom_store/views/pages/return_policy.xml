<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_return_policy_tmpl" name="Return &amp; Exchange Policy Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="pt48 pb48">
                    <div class="container">
                        <h1 class="mb-3">Return &amp; Exchange Policy</h1>
                        <p class="lead text-muted mb-4">7-day easy size exchanges and returns on eligible apparel orders.</p>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h5>Eligibility</h5>
                                <ul>
                                    <li>Raise a return or size-exchange request within 7 days of delivery.</li>
                                    <li>Items must be unused, unwashed, and returned with original tags and packaging intact.</li>
                                    <li>A clear parcel-opening video helps speed up claims for damaged or wrong items.</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5>Exchanges &amp; Refunds</h5>
                                <ul>
                                    <li>Size exchanges are processed promptly once reverse pickup passes QC.</li>
                                    <li>Prepaid refunds return to your original payment method within 5–7 business days after QC.</li>
                                    <li>Need help? <a href="/contactus">Contact Customer Support</a> with your order number.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="page_return_policy" model="website.page">
        <field name="url">/return-policy</field>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
        <field name="view_id" ref="page_return_policy_tmpl"/>
    </record>
</odoo>

