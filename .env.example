# Copy this file to .env and replace all passwords before production deployment.

# Environment Mode (development | production)
ODOO_ENV=development
ODOO_WORKERS=2
ODOO_CRON_THREADS=1
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240

# PostgreSQL Configuration (standalone shared PostgreSQL on localhost for Windows dev; db for Docker production stack)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Odoo Master Password (used when list_db=True in dev; list_db=False in production)
ADMIN_PASSWORD=CHANGE_ME_STRONG_MASTER_PASSWORD

# Web Port
ODOO_PORT=8069

# Upstream Odoo Source Branch (git -C odoo)
ODOO_BRANCH=20.0

# Database & MCP Integration
ODOO_URL=http://localhost:8069
ODOO_DB=localhost
ODOO_USER=admin@yourbrand.in
ODOO_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ODOO_YOLO=true
ODOO_MCP_ENABLE_METHOD_CALLS=true

